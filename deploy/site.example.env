# One installation of COMBIND ULTRA CLOUD = one settings file. Copy this to deploy/site.env (or
# any path, then run the deploy scripts with COMBIND_SITE=that-path) and edit the values.
# Nothing here is secret: never put passwords in this file.

# Where to install: an SSH target with root rights on a Debian/Ubuntu server running nginx and
# certbot (`apt install nginx certbot`).
COMBIND_SSH=root@203.0.113.10

# The two public host names. Both must resolve to the server. Without a domain, use the free
# wildcard DNS of nip.io: for the address 203.0.113.10 that is cloud.203-0-113-10.nip.io.
# The two names must differ (cookies ignore ports, so the portals need separate hosts).
COMBIND_USER_HOST=cloud.203-0-113-10.nip.io
COMBIND_ADMIN_HOST=admin.203-0-113-10.nip.io

# Loopback ports the hub listens on behind nginx. Change them only if something already uses them.
COMBIND_USER_PORT=7401
COMBIND_ADMIN_PORT=7402
