# COMBIND ULTRA CLOUD — the two portals, TLS-terminated here and proxied to the hub on loopback.
# Installed as /etc/nginx/sites-available/zzz-combind (+ link in sites-enabled) by remote.sh;
# named to be read last, so COMBIND never becomes any port's default server. Only the two
# COMBIND host names are matched, so no other site on the server changes.

# Access log without query strings: OAuth callbacks carry one-time codes in the query.
log_format combind_privacy '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                           '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 80;
    server_name @USER_HOST@ @ADMIN_HOST@;
    server_tokens off;

    access_log /var/log/nginx/combind.access.log combind_privacy;
    error_log  /var/log/nginx/combind.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/combind-acme;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name @USER_HOST@;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/combind/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/combind/privkey.pem;

    access_log /var/log/nginx/combind.access.log combind_privacy;
    error_log  /var/log/nginx/combind.error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:@USER_PORT@;
        include /etc/nginx/snippets/combind-proxy.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # The data path: shard uploads (a pack is at most 64 MiB) stream straight through to the hub
    # and pack ranges stream back. Everything here is ciphertext, so nothing is compressed.
    # No trailing slash: nginx would answer /v1/spaces itself with a redirect to /v1/spaces/.
    location ^~ /v1/spaces {
        proxy_pass http://127.0.0.1:@USER_PORT@;
        include /etc/nginx/snippets/combind-proxy.conf;
        client_max_body_size 80m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        gzip off;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name @ADMIN_HOST@;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/combind/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/combind/privkey.pem;

    access_log /var/log/nginx/combind-admin.access.log combind_privacy;
    error_log  /var/log/nginx/combind.error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:@ADMIN_PORT@;
        include /etc/nginx/snippets/combind-proxy.conf;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
